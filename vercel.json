{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/webhooks",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/agents",
      "schedule": "*/5 * * * *"
    }
  ]
}
