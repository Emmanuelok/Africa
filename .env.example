# =============================================================================
# Sokoni environment variables
# Copy to .env.local for local development; configure in Vercel for production.
# Every integration is OPTIONAL — the app falls back to demo mode without it.
# =============================================================================

# Public site URL (used by sitemap, robots, OG image, magic-link host display)
NEXT_PUBLIC_SITE_URL=https://sokoni.africa

# -----------------------------------------------------------------------------
# Anthropic — AI HS classification + RoO reasoning
# Without this, classification falls back to the keyword classifier.
# https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Auth.js — authentication
# Without NEXTAUTH_SECRET, /signin and /signup stay in waitlist-only demo mode.
# When DATABASE_URL is also set, sessions persist in Postgres via the Drizzle
# adapter. With RESEND_API_KEY, magic-link sign-in is enabled.
# Generate a secret: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Postgres — primary database (Neon recommended via Vercel Marketplace)
# Without DATABASE_URL, API routes log to console instead of persisting.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Stripe — billing (Pro SME, SME Bulk, Forwarder, API metering)
# Without STRIPE_SECRET_KEY, pricing CTAs route to /signup waitlist.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO_SME=
STRIPE_PRICE_SME_BULK=
STRIPE_PRICE_FORWARDER=

# -----------------------------------------------------------------------------
# Paystack — African payment processor (NG, GH, KE, ZA primarily)
# https://dashboard.paystack.com/#/settings/developers
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Flutterwave — pan-African payment processor (30+ countries, mobile money)
# https://dashboard.flutterwave.com/dashboard/settings/apis
# -----------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# -----------------------------------------------------------------------------
# Resend — transactional email (waitlist confirmations, magic links, certs)
# Without this, sendEmail() logs to console. https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Sokoni <hello@sokoni.africa>

# -----------------------------------------------------------------------------
# Upstash Redis — rate limiting on /api/classify, /api/checkout, /api/waitlist
# Without this, rate limits are no-ops (permissive). https://upstash.com
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — invisible CAPTCHA on public forms
# Without these, captcha verification passes through (open).
# https://dash.cloudflare.com/?to=/:account/turnstile
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Sentry — error monitoring & performance
# Without this, errors only go to console + Vercel logs. https://sentry.io
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Vercel Cron — authorize daily cleanup at /api/cron/cleanup
# Set in Vercel env; Vercel injects the matching Authorization header.
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# Optional: Slack webhook for waitlist signup notifications
# -----------------------------------------------------------------------------
WAITLIST_SLACK_WEBHOOK=

# -----------------------------------------------------------------------------
# Anthropic model override (optional)
# Pin/override the classification model without a code deploy. Defaults to a
# dated Sonnet snapshot. Example: claude-sonnet-4-6
# -----------------------------------------------------------------------------
ANTHROPIC_MODEL=

# -----------------------------------------------------------------------------
# Resend webhook signing secret — bounce/complaint suppression
# Configure a webhook in Resend pointing at /api/webhooks/resend and paste the
# signing secret here. Without it the endpoint rejects all events (503).
# -----------------------------------------------------------------------------
RESEND_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Upstash QStash — async background jobs (large bulk classification)
# Without these, bulk classify runs synchronously in-request (≤60s budget).
# https://console.upstash.com/qstash
# -----------------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Stripe Tax — automatic VAT/sales tax + tax-ID collection at checkout
# Set to "true" only after completing Stripe Tax registration in the dashboard.
# https://dashboard.stripe.com/settings/tax
# -----------------------------------------------------------------------------
STRIPE_TAX_ENABLED=
